    {"id": "thighs-lift", "label": "Loose thigh pad, thighs lift", "cue": "tighten the pad on the thighs", "fails": ["pivot"], "delta": [{"t": 0.35, "rootY": 0.048, "hipFlex": 12, "thighPad.y": 0.137}, {"t": 0.53, "rootY": 0.048, "hipFlex": 12, "thighPad.y": 0.137}]},
