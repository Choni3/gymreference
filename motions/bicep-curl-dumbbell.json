{
  "version": 1,
  "exercise": "Bicep Curl (Dumbbell)",
  "durationMs": 4000,
  "props": [
    {"id": "axleL", "type": "rod", "length": 0.16, "grip": 0.16, "radius": 0.008, "attach": {"to": "handL"}, "rot": [0, 90, 0]},
    {"id": "dbL", "type": "dumbbell", "attach": {"to": "handL"}},
    {"id": "dbR", "type": "dumbbell", "attach": {"to": "handR"}}
  ],
  "contacts": {"feet": {"at": [0.15, 0, 0], "toeOut": 7}},
  "phases": [
    {"name": "Start", "start": 0, "end": 0.08},
    {"name": "Curl", "start": 0.08, "end": 0.35},
    {"name": "Squeeze", "start": 0.35, "end": 0.49},
    {"name": "Lower", "start": 0.49, "end": 0.96},
    {"name": "Reset", "start": 0.96, "end": 1}
  ],
  "keyframes": [
    {"t": 0, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 2, "forearmPro": -12, "wristFlex": 0},
    {"t": 0.08, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 2, "forearmPro": -12, "wristFlex": 0},
    {"t": 0.225, "forearmPro": -90},
    {"t": 0.35, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 136, "forearmPro": -90, "wristFlex": 0},
    {"t": 0.49, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 136, "forearmPro": -90, "wristFlex": 0},
    {"t": 0.76, "forearmPro": -90},
    {"t": 0.96, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 2, "forearmPro": -12, "wristFlex": 0},
    {"t": 1, "rootY": 0.922, "rootPitch": 0, "scapProt": -6, "shFlex": 2, "shAbd": 9, "elbowFlex": 2, "forearmPro": -12, "wristFlex": 0}
  ],
  "checks": [
    {"id": "torso", "label": "Keep the torso steady", "measure": "trunkLean", "parts": ["trunk"], "min": -6, "max": 6, "tol": 3},
    {"id": "elbows", "label": "Keep upper arms by your sides", "measure": "shFlex", "parts": ["upperArms"], "min": -5, "max": 10, "sides": true, "tol": 4},
    {"id": "stretch", "label": "Lengthen both arms at the start", "measure": "elbowFlex", "parts": ["arms"], "max": 8, "phases": ["Start"], "sides": true, "tol": 4},
    {"id": "squeeze", "label": "Curl the dumbbells toward the shoulders", "measure": "elbowFlex", "parts": ["forearms"], "min": 125, "phases": ["Squeeze"], "sides": true},
    {"id": "palms", "label": "Turn both palms fully up", "measure": {"delta": ["axleL.gripL", "axleL.gripR"], "axis": "y"}, "parts": ["dbL", "dbR"], "min": -0.04, "max": 0.04, "tol": 0.015, "phases": ["Squeeze"]},
    {"id": "wrists", "label": "Keep hands lined up with forearms", "measure": {"delta": ["gripL", "wristL"], "axis": "z"}, "parts": ["hands"], "min": 0.012, "max": 0.08, "tol": 0.008, "phases": ["Squeeze"]}
  ],
  "mistakes": [
    {"id": "swing", "label": "Swinging torso/hips", "cue": "Go lighter, stand still", "fails": ["torso"], "delta": [{"t": 0.17, "rootPitch": 9}, {"t": 0.32, "rootPitch": -22}, {"t": 0.49, "rootPitch": -22}]},
    {"id": "elbows-forward", "label": "Elbows drift forward", "cue": "Keep them by your sides", "fails": ["elbows"], "delta": [{"t": 0.32, "shFlex": 31}, {"t": 0.49, "shFlex": 31}]},
    {"id": "half-rep", "label": "Half reps at the bottom", "cue": "Straighten the arms every rep", "fails": ["stretch"], "delta": [{"t": 0, "elbowFlex": 40}, {"t": 0.08, "elbowFlex": 40}, {"t": 0.22}, {"t": 0.72}, {"t": 0.96, "elbowFlex": 40}, {"t": 1, "elbowFlex": 40}]},
    {"id": "palms-half-turned", "label": "Palms half-turned", "cue": "Rotate fully palm-up", "fails": ["palms"], "delta": [{"t": 0.225, "forearmPro": 55}, {"t": 0.76, "forearmPro": 55}]},
    {"id": "bent-wrists", "label": "Bent wrists", "cue": "Keep wrists neutral and firm", "fails": ["wrists"], "delta": [{"t": 0.32, "wristFlex": 45}, {"t": 0.49, "wristFlex": 45}]}
  ]
}
